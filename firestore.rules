rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in account. Famara does not require a confirmed email (David, 2026-11-15).
    function signedIn() {
      return request.auth != null;
    }
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validYear() {
      return request.resource.data.keys().hasOnly(['birthYear'])
        && request.resource.data.birthYear is int
        && request.resource.data.birthYear >= 1900
        && request.resource.data.birthYear <= request.time.year();
    }
    match /catalog/{document} { allow get: if signedIn(); }
    match /catalogPages/{document} { allow get: if signedIn(); }
    match /catalogIndex/{document} { allow get: if signedIn(); }
    match /catalogRecipes/{document} { allow get: if signedIn(); }

    match /catalogAccounts/{userId} {
      allow get, delete: if owner(userId);
      allow create: if signedIn() && owner(userId) && validYear();
      allow update: if signedIn() && owner(userId) && validYear()
        && request.resource.data.birthYear >= resource.data.birthYear;
    }
    match /catalogTerms/{userId} {
      allow get, delete: if owner(userId);
      allow create: if owner(userId)
        && request.resource.data.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 32
        && request.resource.data.acceptedAt is timestamp;
    }
  }
}
