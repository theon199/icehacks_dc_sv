{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.119.0",
    "zod": "npm:zod@4.6.7"
  },
  "tasks": {
    "check": "deno check _shared/",
    "test": "deno test --allow-env --no-prompt _shared/",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
