{
  "name": "famara",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "brand:assets": "node tools/brand/generate.mjs",
    "bundle:check": "npm run bundle:export && node tools/bundle-check.mjs dist",
    "bundle:export": "expo export --platform ios --output-dir dist"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
